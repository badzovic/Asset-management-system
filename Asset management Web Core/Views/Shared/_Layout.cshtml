@using Microsoft.AspNetCore.Identity
@using AMS_data.Entities
@using Asset_management_Web_Core
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@using Asset_management_Web_Core.Helpers

@inject IViewLocalizer L
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - AMS</title>

    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/fav.png">
    <link rel="stylesheet" href="~/assets/css/plugins/fontawesome-6.css">
    <link rel="stylesheet" href="~/assets/css/plugins/swiper.css">
    <link rel="stylesheet" href="~/assets/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/custom.css">
    @RenderSection("Styles", required: false)

        <script>
               var storedTheme = localStorage.getItem('intellactai');
        if (!storedTheme) {
            storedTheme = "dark";
            localStorage.setItem('intellactai', storedTheme);
        }
        document.documentElement.setAttribute('data-theme', storedTheme);
    </script>

</head>

<body class="user-profile">

    @if (SignInManager.IsSignedIn(User))
    {
    
        <div class="header-area-one">
            <div class="container-30">
                <div class="col-lg-12">
                    <div class="header-inner-one">
                        <div class="left-logo-area">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="logo ams-main-logo">
                                <img src="~/assets/images/logo2.png" alt="AMS Logo" />
                            </a>
                            <div class="left-side-open-clouse" id="collups-left">
                                <img src="~/assets/images/icons/01.svg" alt="menu">
                            </div>
                        </div>

                        <div class="header-right">
                            <div class="action-interactive-area__header">
                                <div class="single_action__haeader language-switcher me-3 dropdown">
                                    <button class="btn btn-sm btn-outline-light dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        @(lang == "bs" ? "BHS" :
                                                                            lang == "en" ? "ENG" :
                                                                            lang == "de" ? "DE" :
                                                                            lang == "it" ? "IT" : "Lang")
                                </button>

                                    <ul class="dropdown-menu ams-language-dropdown">
                                        <li>
                                            <a class="dropdown-item @(lang == "bs" ? "active" : "")"
                                               asp-area=""
                                               asp-controller="Language"
                                               asp-action="ChangeLanguage"
                                               asp-route-lang="bs">BHS</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(lang == "en" ? "active" : "")"
                                               asp-area=""
                                               asp-controller="Language"
                                               asp-action="ChangeLanguage"
                                               asp-route-lang="en">English</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(lang == "de" ? "active" : "")"
                                               asp-area=""
                                               asp-controller="Language"
                                               asp-action="ChangeLanguage"
                                               asp-route-lang="de">Deutsch</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(lang == "it" ? "active" : "")"
                                               asp-area=""
                                               asp-controller="Language"
                                               asp-action="ChangeLanguage"
                                               asp-route-lang="it">Italiano</a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="single_action__haeader user_avatar__information openuptip" flow="down" tooltip="Profile">
                                    <div class="avatar">
                                        <img src="~/assets/images/avatar/user-2.svg" alt="avatar">
                                    </div>

                                    <div class="user_information_main_wrapper slide-down__click">
                                        <div class="user_header">
                                            <div class="main-avatar">
                                                <img src="~/assets/images/avatar/user-2.svg" alt="user">
                                            </div>
                                            <div class="user_naim-information">
                                                <h3 class="title">@User.Identity?.Name</h3>
                                                <span class="desig">@L["AMSUser"]</span>
                                            </div>
                                        </div>

                                        <div class="user_body_content">
                                            <ul class="items">
                                                <li class="single_items">
                                                    <a class="hader_popup_link" asp-area="Identity" asp-page="/Account/Manage/Index">
                                                        <i class="fa-light fa-user"></i>
                                                        @ResourcesHelper.Translate("Profile", lang)
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>

                                        <div class="popup-footer-btn">
                                            <form asp-area="Identity" asp-page="/Account/Logout"
                                                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                                  method="post">
                                                <button type="submit" class="geex-content__header__popup__footer__link border-0 bg-transparent">
                                                    @ResourcesHelper.Translate("Logout", lang) <i class="fa-light fa-arrow-right"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="dash-board-main-wrapper">
            <div class="left-side-bar">
                <div class="overlay-mobile-area"></div>

                <div class="inner">

                    <div class="single-menu-wrapper">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="single-menu">
                            <div class="icon">
                                <img src="~/assets/images/icons/01.png" alt="home">
                            </div>
                            <p>@ResourcesHelper.Translate("Home", lang)</p>
                        </a>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="single-menu-wrapper">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="single-menu">
                                <div class="icon">
                                    <img src="~/assets/images/icons/02.png" alt="users">
                                </div>
                                <p>@ResourcesHelper.Translate("Users", lang)</p>
                            </a>

                            <a class="collapse-btn collapsed single-menu"
                               data-bs-toggle="collapse"
                               href="#settingsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="settingsMenu">
                                <div class="icon">
                                    <img src="~/assets/images/icons/08.png" alt="settings">
                                </div>
                                <p>@ResourcesHelper.Translate("Settings", lang)</p>
                            </a>

                            <div class="collapse" id="settingsMenu">
                                <ul class="submenu rts-default-sidebar-list">
                                    <li>
                                        <a asp-area="Admin" asp-controller="DataCapture" asp-action="Index">
                                            <i class="fa-sharp fa-regular fa-database"></i>
                                            <span>@ResourcesHelper.Translate("DataCapture", lang)</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }

                    @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
                    {
                        <div class="single-menu-wrapper">

                            <a class="collapse-btn collapsed single-menu"
                               data-bs-toggle="collapse"
                               href="#weaponsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="weaponsMenu">

                                <div class="icon">
                                    <img src="~/assets/images/icons/16.png" alt="weapons">
                                </div>

                                <p>@ResourcesHelper.Translate("WeaponsRegistration", lang)</p>
                            </a>

                            <div class="collapse" id="weaponsMenu">

                                <ul class="submenu rts-default-sidebar-list">



                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Weapons"
                                           asp-action="Register">
                                            <i class="fa-solid fa-gun"></i>
                                            <span>@ResourcesHelper.Translate("RegisterWeapon", lang)</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Weapons"
                                           asp-action="Check">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                            <span>@ResourcesHelper.Translate("CheckWeaponStatus", lang)</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Weapons"
                                           asp-action="PrepareMove">
                                            <i class="fa-solid fa-right-left"></i>
                                            <span>@ResourcesHelper.Translate("PrepareWeaponMove", lang)</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Weapons"
                                           asp-action="AuthoriseMove">
                                            <i class="fa-solid fa-shield"></i>
                                            <span>@ResourcesHelper.Translate("AuthoriseWeaponMove", lang)</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Weapons"
                                           asp-action="QueryGenerator">
                                            <i class="fa-solid fa-file-lines"></i>
                                            <span>@ResourcesHelper.Translate("QueryGenerator", lang)</span>
                                        </a>
                                    </li>
                                    <li>
                                    <a asp-area="Admin"
                                       asp-controller="Weapons"
                                       asp-action="Mark">
                                        <i class="fa-solid fa-barcode"></i>
                                        <span>@ResourcesHelper.Translate("MarkWeapon", lang)</span>
                                    </a>
                                    </li>
                                    <li>
                                    <a asp-area="Admin"
                                       asp-controller="Weapons"
                                       asp-action="MarkingLayouts">
                                        <i class="fa-solid fa-layer-group"></i>
                                        <span>Marking Layouts</span>
                                    </a>
                                    </li>
                                    <li>
                                    <a asp-area="Admin"
                                       asp-controller="Weapons"
                                       asp-action="MarkingQueue">
                                        <i class="fa-solid fa-list-check"></i>
                                        <span>Marking Queue</span>
                                    </a>
                                    </li>
                                </ul>

                            </div>

                      

                        </div>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
                    {
                        <div class="single-menu-wrapper">

                            <a class="collapse-btn collapsed single-menu"
                               data-bs-toggle="collapse"
                               href="#evidenceMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="evidenceMenu">

                                <div class="icon">
                                    <i class="fa-solid fa-box-archive" style="color: rgb(240, 240, 240);"></i>
                                </div>

                                <p>@ResourcesHelper.Translate("EvidenceManagement", lang)</p>
                            </a>

                            <div class="collapse" id="evidenceMenu">
                                <ul class="submenu rts-default-sidebar-list">

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Evidence"
                                           asp-action="Index">
                                            <i class="fa-solid fa-box-open"></i>
                                            <span>@ResourcesHelper.Translate("EvidenceDeposit", lang)</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Evidence"
                                           asp-action="QueryGenerator">
                                            <i class="fa-solid fa-file-lines"></i>
                                            <span>@ResourcesHelper.Translate("QueryGenerator", lang)</span>
                                        </a>
                                    </li>

                                </ul>
                            </div>

                        </div>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
                    {
                        <div class="single-menu-wrapper">

                            <a class="collapse-btn collapsed single-menu"
                               data-bs-toggle="collapse"
                               href="#narcoticsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="narcoticsMenu">

                                <div class="icon">
                                    <i class="fa-solid fa-prescription-bottle-medical" style="color: rgb(240, 240, 240);"></i>
                                </div>

                                <p>@ResourcesHelper.Translate("NarcoticsManagement", lang)</p>
                            </a>

                            <div class="collapse" id="narcoticsMenu">
                                <ul class="submenu rts-default-sidebar-list">

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Narcotics"
                                           asp-action="Index">
                                            <i class="fa-solid fa-box-archive"></i>
                                            <span>@ResourcesHelper.Translate("RegisterNarcotics", lang)</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Narcotics"
                                           asp-action="QueryGenerator">
                                            <i class="fa-solid fa-file-lines"></i>
                                            <span>@ResourcesHelper.Translate("QueryGenerator", lang)</span>
                                        </a>
                                    </li>

                                </ul>
                            </div>

                        </div>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Skladiste"))
                    {
                        <div class="single-menu-wrapper">

                            <a href="#" class="single-menu">
                                <div class="icon">
                                    <i class="fa-solid fa-warehouse" style="color: rgb(240, 240, 240);"></i>
                                </div>

                                <p>@ResourcesHelper.Translate("Warehouse", lang)</p>
                            </a>

                        </div>
                    }

                 

                </div>

                <div class="bottom-user">
                    <div class="user-wrapper">
                        <img src="~/assets/images/avatar/user-2.svg" alt="avatar">
                        <div class="info">
                            <h6 class="title">@User.Identity?.Name</h6>
                            <a href="#">AMS</a>
                        </div>
                        <span>Online</span>
                    </div>
                </div>
            </div>

            <div class="user-profile-area">
                <div class="container-custom">
                    @RenderBody()
                </div>

                <div class="copyright-area-bottom">
                    <p>@L["Copyright"] © @DateTime.Now.Year</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container-custom">
            @RenderBody()
        </div>
    }

    <script src="~/assets/js/plugins/jquery.min.js"></script>
    <script src="~/assets/js/plugins/swiper.js" defer></script>
    <script src="~/assets/js/plugins/bootstrap.min.js" defer></script>
    <script src="~/assets/js/main.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>



    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>