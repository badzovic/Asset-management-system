@model Asset_management_Web_Core.Areas.Admin.ViewModels.WeaponModelFormViewModel
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
}

<div class="half-input-wrapper">
    <div class="single">
        <label asp-for="Name">@ResourcesHelper.Translate("Name", lang)</label>
        <input asp-for="Name" placeholder="@ResourcesHelper.Translate("EnterName", lang)" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="single">
        <label asp-for="Code">@ResourcesHelper.Translate("Code", lang)</label>
        <input asp-for="Code" placeholder="@ResourcesHelper.Translate("EnterCode", lang)" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
</div>

<div class="half-input-wrapper">
    <div class="single">
        <label asp-for="WeaponTypeId">@ResourcesHelper.Translate("WeaponType", lang)</label>
        <select asp-for="WeaponTypeId" asp-items="Model.WeaponTypes">
            <option value="">@ResourcesHelper.Translate("SelectWeaponType", lang)</option>
        </select>
        <span asp-validation-for="WeaponTypeId" class="text-danger"></span>
    </div>

    <div class="single">
        <label asp-for="ManufacturerId">@ResourcesHelper.Translate("Manufacturer", lang)</label>
        <select asp-for="ManufacturerId" asp-items="Model.Manufacturers">
            <option value="">@ResourcesHelper.Translate("SelectManufacturer", lang)</option>
        </select>
        <span asp-validation-for="ManufacturerId" class="text-danger"></span>
    </div>
</div>

<div class="half-input-wrapper">
    <div class="single">
        <label asp-for="CaliberId">@ResourcesHelper.Translate("Caliber", lang)</label>
        <select asp-for="CaliberId" asp-items="Model.Calibers">
            <option value="">@ResourcesHelper.Translate("SelectCaliber", lang)</option>
        </select>
        <span asp-validation-for="CaliberId" class="text-danger"></span>
    </div>

    <div class="single">
        <label asp-for="ImageFile">@ResourcesHelper.Translate("Image", lang)</label>
        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.svg" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
{
    <div class="ams-image-preview-wrap">
        <span>@ResourcesHelper.Translate("CurrentImage", lang)</span>
        <img src="@Model.ExistingImagePath" class="ams-image-preview" alt="weapon model" />
    </div>
}

<div class="half-input-wrapper">
    <div class="single">
        <label asp-for="Description">@ResourcesHelper.Translate("Description", lang)</label>
        <textarea asp-for="Description" placeholder="@ResourcesHelper.Translate("EnterDescription", lang)"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<div class="ams-checkbox-row">
    <label class="ams-switch">
        <input asp-for="IsActive" />
        <span class="ams-slider"></span>
    </label>

    <span class="ams-checkbox-label">
        @ResourcesHelper.Translate("IsActive", lang)
    </span>
</div>