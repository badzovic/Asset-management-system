@model Asset_management_Web_Core.Areas.Admin.ViewModels.ResetPasswordViewModel
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
}

<div class="user-profile-inner">

    <div class="ams-page-header">
        <div>
            <h4 class="title mb-1">
                Reset Password
            </h4>

            <p class="ams-page-subtitle">
                @Model.UserName
            </p>
        </div>
    </div>

    <div class="user-profile-main-wrapper">

        <form asp-action="ResetPassword" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="UserName" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="half-input-wrapper">

                <div class="single">
                    <label asp-for="NewPassword">
                        New Password
                    </label>

                    <input asp-for="NewPassword" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger"></span>
                </div>

                <div class="single">
                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>
                </div>

            </div>

            <button type="submit"
                    class="rts-btn btn-primary mt--20">

                Reset Password

            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}