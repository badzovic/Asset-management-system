@model Asset_management_Web_Core.Areas.Admin.ViewModels.CreateUserViewModel
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";

    ViewData["Title"] = ResourcesHelper.Translate("NewUser", lang);
}

<div class="user-profile-inner">

    <h4 class="title mb-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success ams-alert">
                @TempData["SuccessMessage"]
            </div>
        }
        @ResourcesHelper.Translate("NewUser", lang)
    </h4>

    <div class="user-profile-main-wrapper">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="half-input-wrapper">

                <div class="single">
                    <label asp-for="UserName">
                        @ResourcesHelper.Translate("Username", lang)
                    </label>

                    <input asp-for="UserName"
                           placeholder="@ResourcesHelper.Translate("EnterUsername", lang)" />
                </div>

                <div class="single">
                    <label asp-for="Password">
                        @ResourcesHelper.Translate("Password", lang)
                    </label>

                    <input asp-for="Password"
                           placeholder="@ResourcesHelper.Translate("EnterPassword", lang)" />
                </div>

            </div>

            <div class="half-input-wrapper">

                <div class="single">
                    <label asp-for="Ime">
                        @ResourcesHelper.Translate("FirstName", lang)
                    </label>

                    <input asp-for="Ime"
                           placeholder="@ResourcesHelper.Translate("EnterFirstName", lang)" />
                </div>

                <div class="single">
                    <label asp-for="Prezime">
                        @ResourcesHelper.Translate("LastName", lang)
                    </label>

                    <input asp-for="Prezime"
                           placeholder="@ResourcesHelper.Translate("EnterLastName", lang)" />
                </div>

            </div>

            <div class="half-input-wrapper">

                <div class="single">
                    <label>Role</label>

                    <div class="ams-role-grid">

                        @foreach (var role in Model.Roles)
                        {
                            <label class="ams-role-option">

                                <input type="checkbox"
                                       name="SelectedRoles"
                                       value="@role.Value"
                                       @(Model.SelectedRoles.Contains(role.Value ?? "") ? "checked" : null) />

                                <span>@role.Text</span>

                            </label>
                        }

                    </div>
                </div>

                <div class="single">
                    <label asp-for="OrganizacionaJedinicaId">
                        @ResourcesHelper.Translate("OrganizationalUnit", lang)
                    </label>

                    <select asp-for="OrganizacionaJedinicaId"
                            asp-items="Model.OrganizacioneJedinice">

                        <option value="">
                            @ResourcesHelper.Translate("NoOrganizationalUnit", lang)
                        </option>

                    </select>
                </div>

            </div>

            <div class="half-input-wrapper">

                <div class="single">
                    <label asp-for="SkladisteId">
                        @ResourcesHelper.Translate("Warehouse", lang)
                    </label>

                    <select asp-for="SkladisteId"
                            asp-items="Model.Skladista">

                        <option value="">
                            @ResourcesHelper.Translate("NoWarehouse", lang)
                        </option>

                    </select>
                </div>

            </div>

            <button type="submit" class="rts-btn btn-primary mt--20">
                @ResourcesHelper.Translate("CreateUser", lang)
            </button>

        </form>

    </div>
    <div class="user-profile-main-wrapper mt--30">
        <h5 class="ams-section-title">
            @ResourcesHelper.Translate("Users", lang)
        </h5>

        <div class="table-responsive ams-active-weapons-scroll">
            <table class="table ams-table">
                <thead>
                    <tr>
                        <th>@ResourcesHelper.Translate("Username", lang)</th>
                        <th>@ResourcesHelper.Translate("FirstName", lang)</th>
                        <th>@ResourcesHelper.Translate("LastName", lang)</th>
                        <th>@ResourcesHelper.Translate("Role", lang)</th>
                        <th>@ResourcesHelper.Translate("OrganizationalUnit", lang)</th>
                        <th>@ResourcesHelper.Translate("Warehouse", lang)</th>
                        <th>@ResourcesHelper.Translate("Status", lang)</th>
                        <th class="text-end">@ResourcesHelper.Translate("Actions", lang)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Ime</td>
                            <td>@user.Prezime</td>
                            <td>@user.RoleName</td>
                            <td>@user.OrganizacionaJedinica</td>
                            <td>@user.Skladiste</td>
                            <td>
                                @if (user.Aktivan)
                                {
                                    <span class="ams-badge ams-badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="ams-badge ams-badge-muted">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="ams-btn-small">
                                    @ResourcesHelper.Translate("Edit", lang)
                                </a>

                                <a asp-action="ResetPassword" asp-route-id="@user.Id" class="ams-btn-small ms-2">
                                    Reset password
                                </a>
                            </td>
                        </tr>
                    }

                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                @ResourcesHelper.Translate("NoRecordsFound", lang)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}