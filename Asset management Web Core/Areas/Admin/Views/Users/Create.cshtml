@model Asset_management_Web_Core.Areas.Admin.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Novi korisnik";
}

<div class="user-profile-inner">
    <h4 class="title mb-4">Novi korisnik</h4>

    <div class="user-profile-main-wrapper">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="UserName">Korisničko ime</label>
                    <input asp-for="UserName" placeholder="Unesite korisničko ime" />
                </div>

                <div class="single">
                    <label asp-for="Password">Lozinka</label>
                    <input asp-for="Password" placeholder="Unesite lozinku" />
                </div>
            </div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="Ime">Ime</label>
                    <input asp-for="Ime" placeholder="Unesite ime" />
                </div>

                <div class="single">
                    <label asp-for="Prezime">Prezime</label>
                    <input asp-for="Prezime" placeholder="Unesite prezime" />
                </div>
            </div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="RoleName">Rola</label>
                    <select asp-for="RoleName" asp-items="Model.Roles">
                        <option value="">-- Odaberi rolu --</option>
                    </select>
                </div>

                <div class="single">
                    <label asp-for="OrganizacionaJedinicaId">Organizaciona jedinica</label>
                    <select asp-for="OrganizacionaJedinicaId" asp-items="Model.OrganizacioneJedinice">
                        <option value="">-- Bez organizacione jedinice --</option>
                    </select>
                </div>
            </div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="SkladisteId">Skladište</label>
                    <select asp-for="SkladisteId" asp-items="Model.Skladista">
                        <option value="">-- Bez skladišta --</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="rts-btn btn-primary mt--20">
                Kreiraj korisnika
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}