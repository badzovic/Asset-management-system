@model Asset_management_Web_Core.Areas.Admin.ViewModels.CreateUserViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizerFactory LocalizerFactory

@{
    var L = LocalizerFactory.Create("AppText", "Asset_management_Web_Core");
    ViewData["Title"] = L["NewUser"];
}

<div class="user-profile-inner">
    <h4 class="title mb-4">@L["NewUser"]</h4>

    <div class="user-profile-main-wrapper">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="UserName">@L["Username"]</label>
                    <input asp-for="UserName" placeholder="@L["EnterUsername"]" />
                </div>

                <div class="single">
                    <label asp-for="Password">@L["Password"]</label>
                    <input asp-for="Password" placeholder="@L["EnterPassword"]" />
                </div>
            </div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="Ime">@L["FirstName"]</label>
                    <input asp-for="Ime" placeholder="@L["EnterFirstName"]" />
                </div>

                <div class="single">
                    <label asp-for="Prezime">@L["LastName"]</label>
                    <input asp-for="Prezime" placeholder="@L["EnterLastName"]" />
                </div>
            </div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="RoleName">@L["Role"]</label>
                    <select asp-for="RoleName" asp-items="Model.Roles">
                        <option value="">@L["SelectRole"]</option>
                    </select>
                </div>

                <div class="single">
                    <label asp-for="OrganizacionaJedinicaId">@L["OrganizationalUnit"]</label>
                    <select asp-for="OrganizacionaJedinicaId" asp-items="Model.OrganizacioneJedinice">
                        <option value="">@L["NoOrganizationalUnit"]</option>
                    </select>
                </div>
            </div>

            <div class="half-input-wrapper">
                <div class="single">
                    <label asp-for="SkladisteId">@L["Warehouse"]</label>
                    <select asp-for="SkladisteId" asp-items="Model.Skladista">
                        <option value="">@L["NoWarehouse"]</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="rts-btn btn-primary mt--20">
                @L["CreateUser"]
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}