@model Asset_management_Web_Core.Areas.Admin.ViewModels.Weapons.WeaponCheckViewModel
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
    ViewData["Title"] = ResourcesHelper.Translate("CheckWeaponStatus", lang);
}
<style>
    .container-custom {
        width: 100% !important;
        max-width: 100% !important;
        padding-left: 24px !important;
        padding-right: 24px !important;
    }

    .user-profile-inner {
        width: 100% !important;
        max-width: 100% !important;
    }

    .ams-check-grid {
        display: grid !important;
        grid-template-columns: 1fr 1.8fr !important;
        gap: 24px !important;
        width: 100% !important;
    }
</style>
<div class="user-profile-inner">
  
    <div class="ams-page-header">
        <div>
            <h4 class="title mb-1">@ResourcesHelper.Translate("CheckWeaponStatus", lang)</h4>
            <p class="ams-page-subtitle">@ResourcesHelper.Translate("CheckWeaponStatusDescription", lang)</p>
        </div>
    </div>

    <div class="ams-register-grid ams-check-grid">
        <div>
            <div class="user-profile-main-wrapper">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("SelectedWeapon", lang)</h5>

                <form method="get" asp-action="Check" class="ams-filter-bar mb-3">
                    <div class="ams-filter-item">
                        <select id="weaponSearchSelect"
                                class="ams-select2">
                            <option value="">@ResourcesHelper.Translate("SearchWeaponPlaceholder", lang)</option>

                            @foreach (var item in Model.ActiveWeapons)
                            {
                                <option value="@item.Id">
                                    @item.RegistrationNo - @item.FactorySerial - @item.WeaponModel?.Name
                                </option>
                            }
                        </select>
                    </div>

                  
                </form>

                @if (Model.SelectedWeapon != null)
                {
                    <div class="ams-weapon-summary">
                        <div>
                            <strong>@ResourcesHelper.Translate("RegistrationNo", lang)</strong>
                            <span>@Model.SelectedWeapon.RegistrationNo</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("FactorySerial", lang)</strong>
                            <span>@Model.SelectedWeapon.FactorySerial</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("WeaponModel", lang)</strong>
                            <span>@Model.SelectedWeapon.WeaponModel?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("WeaponType", lang)</strong>
                            <span>@Model.SelectedWeapon.WeaponType?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("Manufacturer", lang)</strong>
                            <span>@Model.SelectedWeapon.Manufacturer?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("Caliber", lang)</strong>
                            <span>@Model.SelectedWeapon.Caliber?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("OriginalState", lang)</strong>
                            <span>@Model.SelectedWeapon.OriginalStateLookup?.Name</span>
                        </div>
                    </div>
                }
                else
                {
                    <div >
                        @ResourcesHelper.Translate("SelectWeaponFromList", lang)
                    </div>
                }
            </div>

            <div class="user-profile-main-wrapper mt--30">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("WeaponCheckForm", lang)</h5>

                <form asp-action="Check" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="SelectedWeaponId" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="half-input-wrapper">
                        <div class="single">
                            <label asp-for="CheckDate">
                                @ResourcesHelper.Translate("CheckDate", lang) <span class="ams-required">*</span>
                            </label>
                            <input asp-for="CheckDate" type="date" />
                            <span asp-validation-for="CheckDate" class="text-danger"></span>
                        </div>

                        <div class="single">
                            <label asp-for="CheckStateLookupId">
                                @ResourcesHelper.Translate("State", lang) <span class="ams-required">*</span>
                            </label>
                            <select asp-for="CheckStateLookupId" asp-items="Model.CheckStates">
                                <option value="">@ResourcesHelper.Translate("SelectOption", lang)</option>
                            </select>
                            <span asp-validation-for="CheckStateLookupId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="half-input-wrapper">
                        <div class="single">
                            <label asp-for="IdNo">@ResourcesHelper.Translate("IdNo", lang)</label>
                            <input asp-for="IdNo" />
                        </div>
                    </div>

                    <div class="half-input-wrapper">
                        <div class="single">
                            <label asp-for="Comments">@ResourcesHelper.Translate("Comments", lang)</label>
                            <textarea asp-for="Comments"></textarea>
                        </div>
                    </div>

                    <div class="ams-form-actions">
                        <button type="submit" class="rts-btn btn-primary" @(Model.SelectedWeapon == null ? "disabled" : "")>
                            @ResourcesHelper.Translate("Save", lang)
                        </button>
                    </div>
                </form>
            </div>

            <div class="user-profile-main-wrapper mt--30">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("CheckHistory", lang)</h5>
              
                <div class="table-responsive ams-active-weapons-scroll">
                    <table class="table ams-table" id="checkWeaponsTable">
                        <thead>
                            <tr>
                                <th>@ResourcesHelper.Translate("CheckDate", lang)</th>
                                <th>@ResourcesHelper.Translate("State", lang)</th>
                                <th>@ResourcesHelper.Translate("IdNo", lang)</th>
                                <th>@ResourcesHelper.Translate("Comments", lang)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CheckHistory)
                            {
                                <tr>
                                    <td>@item.CheckDate.ToString("dd.MM.yyyy")</td>
                                    <td>@item.CheckStateLookup?.Name</td>
                                    <td>@item.IdNo</td>
                                    <td>@item.Comments</td>
                                </tr>
                            }

                            @if (!Model.CheckHistory.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        @ResourcesHelper.Translate("NoRecordsFound", lang)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="user-profile-main-wrapper">
            <h5 class="ams-section-title">@ResourcesHelper.Translate("ActiveWeapons", lang)</h5>
            <div class="ams-table-toolbar">
                <input type="text"
                       id="checkWeaponsTableSearch"
                       class="ams-table-search"
                       placeholder="@ResourcesHelper.Translate("Search", lang)" />
            </div>
            <div class="table-responsive ams-active-weapons-scroll">
                <table class="table ams-table" id="checkWeaponsTable">
                    <thead>
                        <tr>
                            <th>@ResourcesHelper.Translate("RegistrationNo", lang)</th>
                            <th>@ResourcesHelper.Translate("FactorySerial", lang)</th>
                            <th>@ResourcesHelper.Translate("WeaponModel", lang)</th>
                            <th>@ResourcesHelper.Translate("WeaponType", lang)</th>
                            <th>@ResourcesHelper.Translate("Actions", lang)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ActiveWeapons)
                        {
                            <tr class="ams-clickable-row"
                                data-url="@Url.Action("Check", "Weapons", new { area = "Admin", weaponId = item.Id, searchTerm = Model.SearchTerm })">
                                <td>@item.RegistrationNo</td>
                                <td>@item.FactorySerial</td>
                                <td>@item.WeaponModel?.Name</td>
                                <td>@item.WeaponType?.Name</td>
                                <td>
                                    <a asp-action="Check"
                                       asp-route-weaponId="@item.Id"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       class="ams-btn-small">
                                        @ResourcesHelper.Translate("Select", lang)
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.ActiveWeapons.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    @ResourcesHelper.Translate("NoRecordsFound", lang)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
                $(document).ready(function () {

            $('#weaponSearchSelect').select2({
                width: '100%',
                placeholder: '-- Search weapon --',
                allowClear: true
            });

            $('#weaponSearchSelect').on('change', function () {

                const weaponId = $(this).val();

                if (!weaponId)
                    return;

                window.location.href =
                    '/Admin/Weapons/Check?weaponId=' + weaponId;
            });

        });
                $('.ams-clickable-row').on('click', function () {

            const url = $(this).data('url');

            if (url)
                window.location.href = url;
        });
                $('#checkWeaponsTableSearch').on('keyup', function () {
            const value = $(this).val().toLowerCase();

            $('#checkWeaponsTable tbody tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });
    </script>
}