@model Asset_management_Web_Core.Areas.Admin.ViewModels.Weapons.WeaponMarkingViewModel
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
    ViewData["Title"] = ResourcesHelper.Translate("MarkWeapon", lang);
}

<style>
    .container-custom,
    .user-profile-inner {
        width: 100% !important;
        max-width: 100% !important;
    }

    .ams-mark-grid {
        display: grid !important;
        grid-template-columns: 1fr 1.6fr !important;
        gap: 24px !important;
        width: 100% !important;
    }

    .ams-mark-preview {
        background: #f8fafc;
        color: #111827;
        border-radius: 16px;
        min-height: 300px;
        padding: 28px;
        border: 1px solid #334155;
    }

    .ams-mark-label-box {
        background: #fff;
        border: 2px solid #111827;
        min-height: 220px;
        padding: 28px;
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 22px;
        align-items: start;
    }

    .ams-mark-code {
        width: 70px;
        height: 70px;
        background: repeating-linear-gradient( 45deg, #111 0, #111 4px, #fff 4px, #fff 8px );
        border: 4px solid #111;
    }

    .ams-mark-text h3 {
        margin: 0 0 10px;
        font-size: 30px;
        font-weight: 900;
    }

    .ams-mark-text p {
        margin: 6px 0;
        font-size: 18px;
        font-weight: 700;
    }
</style>

<div class="user-profile-inner">

    <div class="ams-page-header">
        <div>
            <h4 class="title mb-1">@ResourcesHelper.Translate("MarkWeapon", lang)</h4>
            <p class="ams-page-subtitle">@ResourcesHelper.Translate("MarkWeaponDescription", lang)</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success ams-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="ams-mark-grid">

        <div>
            <div class="user-profile-main-wrapper">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("SelectedWeapon", lang)</h5>

                <div class="mb-3">
                    <select id="weaponMarkSearchSelect" class="ams-select2">
                        <option value="">@ResourcesHelper.Translate("SearchWeaponPlaceholder", lang)</option>

                        @foreach (var item in Model.Weapons)
                        {
                            <option value="@item.Id">
                                @item.RegistrationNo - @item.FactorySerial - @item.WeaponModel?.Name
                            </option>
                        }
                    </select>
                </div>

                @if (Model.SelectedWeapon != null)
                {
                    <div class="ams-weapon-summary">
                        <div>
                            <strong>@ResourcesHelper.Translate("RegistrationNo", lang)</strong>
                            <span>@Model.SelectedWeapon.RegistrationNo</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("FactorySerial", lang)</strong>
                            <span>@Model.SelectedWeapon.FactorySerial</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("WeaponModel", lang)</strong>
                            <span>@Model.SelectedWeapon.WeaponModel?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("WeaponType", lang)</strong>
                            <span>@Model.SelectedWeapon.WeaponType?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("Manufacturer", lang)</strong>
                            <span>@Model.SelectedWeapon.Manufacturer?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("Caliber", lang)</strong>
                            <span>@Model.SelectedWeapon.Caliber?.Name</span>
                        </div>

                        <div>
                            <strong>@ResourcesHelper.Translate("RegMarked", lang)</strong>
                            <span>
                                @if (Model.SelectedWeapon.IsMarked)
                                {
                                    <span class="ams-badge ams-badge-success">@ResourcesHelper.Translate("Yes", lang)</span>
                                }
                                else
                                {
                                    <span class="ams-badge ams-badge-muted">@ResourcesHelper.Translate("No", lang)</span>
                                }
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info ams-alert">
                        @ResourcesHelper.Translate("SelectWeaponFromList", lang)
                    </div>
                }
            </div>

            <div class="user-profile-main-wrapper mt--30">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("MarkingHistory", lang)</h5>

                <div class="table-responsive ams-active-weapons-scroll">
                    <table class="table ams-table">
                        <thead>
                            <tr>
                                <th>@ResourcesHelper.Translate("Date", lang)</th>
                                <th>@ResourcesHelper.Translate("Layout", lang)</th>
                                <th>@ResourcesHelper.Translate("Status", lang)</th>
                                <th>@ResourcesHelper.Translate("Actions", lang)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MarkingHistory)
                            {
                                <tr>
                                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.MarkingLayout?.Name</td>
                                    <td><span class="ams-badge ams-badge-muted">@item.Status</span></td>
                                    <td>
                                        @if (item.Status == "Prepared")
                                        {
                                            <form asp-action="SendMarkingJob" method="post" style="display:inline-block;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="ams-btn-small">
                                                    Send
                                                </button>
                                            </form>
                                        }

                                        @if (item.Status == "Prepared" || item.Status == "SentToMarker")
                                        {
                                            <form asp-action="CompleteMarkingJob" method="post" style="display:inline-block;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="ams-btn-small ms-2">
                                                    Complete
                                                </button>
                                            </form>

                                            <form asp-action="FailMarkingJob" method="post" style="display:inline-block;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="ams-btn-small ms-2">
                                                    Failed
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!Model.MarkingHistory.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        @ResourcesHelper.Translate("NoRecordsFound", lang)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div>
            <div class="user-profile-main-wrapper">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("MarkingData", lang)</h5>

                <form asp-action="Mark" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="SelectedWeaponId" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="half-input-wrapper">
                        <div class="single">
                            <label asp-for="MarkingLayoutId">
                                @ResourcesHelper.Translate("Layout", lang) <span class="ams-required">*</span>
                            </label>
                            <select asp-for="MarkingLayoutId"
                                    asp-items="Model.MarkingLayouts"
                                    class="ams-select2"
                                    id="MarkingLayoutId">
                                <option value="">@ResourcesHelper.Translate("SelectOption", lang)</option>
                            </select>
                            <span asp-validation-for="MarkingLayoutId" class="text-danger"></span>
                        </div>

                        <div class="single">
                            <label asp-for="DataMatrixValue">Data Matrix</label>
                            <input asp-for="DataMatrixValue" id="DataMatrixValue" />
                        </div>
                    </div>

                    <div class="half-input-wrapper">
                        <div class="single">
                            <label asp-for="MarkingText1">@ResourcesHelper.Translate("MarkingText1", lang)</label>
                            <input asp-for="MarkingText1" id="MarkingText1" />
                        </div>

                        <div class="single">
                            <label asp-for="MarkingText2">@ResourcesHelper.Translate("MarkingText2", lang)</label>
                            <input asp-for="MarkingText2" id="MarkingText2" />
                        </div>
                    </div>

                    <div class="half-input-wrapper">
                        <div class="single">
                            <label asp-for="MarkingText3">@ResourcesHelper.Translate("MarkingText3", lang)</label>
                            <input asp-for="MarkingText3" id="MarkingText3" />
                        </div>

                        <div class="single">
                            <label asp-for="QrValue">QR</label>
                            <input asp-for="QrValue" id="QrValue" />
                        </div>
                    </div>

                    <div class="ams-mark-preview mt--20">
                        <div class="ams-mark-preview-header">
                            <strong>Layout preview</strong>
                            <span id="layoutPreviewName">No layout selected</span>
                        </div>

                        <div class="ams-layout-preview-wrap">
                            <svg id="markLayoutPreview"
                                 viewBox="0 0 100 80"
                                 preserveAspectRatio="xMidYMid meet"
                                 class="ams-mark-layout-svg">

                                <rect x="0"
                                      y="0"
                                      width="100"
                                      height="80"
                                      fill="#ffffff"
                                      stroke="#111827"
                                      stroke-width="0.3" />
                            </svg>
                        </div>
                    </div>

                    <div class="ams-form-actions mt--20">
                        <button type="submit"
                                class="rts-btn btn-primary"
                                @(Model.SelectedWeapon == null ? "disabled" : "")>
                            @ResourcesHelper.Translate("PrepareMarkingJob", lang)
                        </button>
                    </div>
                </form>
            </div>

            <div class="user-profile-main-wrapper mt--30">
                <h5 class="ams-section-title">@ResourcesHelper.Translate("ActiveWeapons", lang)</h5>

                <div class="ams-table-toolbar">
                    <input type="text"
                           id="markWeaponsTableSearch"
                           class="ams-table-search"
                           placeholder="@ResourcesHelper.Translate("Search", lang)" />
                </div>

                <div class="table-responsive ams-active-weapons-scroll">
                    <table class="table ams-table" id="markWeaponsTable">
                        <thead>
                            <tr>
                                <th>@ResourcesHelper.Translate("RegistrationNo", lang)</th>
                                <th>@ResourcesHelper.Translate("FactorySerial", lang)</th>
                                <th>@ResourcesHelper.Translate("WeaponModel", lang)</th>
                                <th>@ResourcesHelper.Translate("RegMarked", lang)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Weapons)
                            {
                                <tr class="ams-clickable-row"
                                    data-url="@Url.Action("Mark", "Weapons", new { area = "Admin", weaponId = item.Id })">
                                    <td>@item.RegistrationNo</td>
                                    <td>@item.FactorySerial</td>
                                    <td>@item.WeaponModel?.Name</td>
                                    <td>
                                        @if (item.IsMarked)
                                        {
                                            <span class="ams-badge ams-badge-success">@ResourcesHelper.Translate("Yes", lang)</span>
                                        }
                                        else
                                        {
                                            <span class="ams-badge ams-badge-muted">@ResourcesHelper.Translate("No", lang)</span>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!Model.Weapons.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        @ResourcesHelper.Translate("NoRecordsFound", lang)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
               $(document).ready(function () {
                    $('.ams-select2').select2({
                width: '100%',
                placeholder: '-- Select --',
                allowClear: true
            });
            const previewSvg = document.getElementById('markLayoutPreview');
const previewName = document.getElementById('layoutPreviewName');

const variableValues = {
    RegistrationNo: '@(Model.SelectedWeapon?.RegistrationNo ?? "")',
    FactorySerial: '@(Model.SelectedWeapon?.FactorySerial ?? "")',
    WeaponModel: '@(Model.SelectedWeapon?.WeaponModel?.Name ?? "")',
    WeaponType: '@(Model.SelectedWeapon?.WeaponType?.Name ?? "")',
    Manufacturer: '@(Model.SelectedWeapon?.Manufacturer?.Name ?? "")',
    Caliber: '@(Model.SelectedWeapon?.Caliber?.Name ?? "")',
    MarkingText1: $('#MarkingText1').val() || '',
    MarkingText2: $('#MarkingText2').val() || '',
    MarkingText3: $('#MarkingText3').val() || '',
    DataMatrixValue: $('#DataMatrixValue').val() || '',
    QrValue: $('#QrValue').val() || ''
};

function resolveVariable(name) {
    if (!name) return '';
    return variableValues[name] || '[' + name + ']';
}

function clearPreview(width, height) {
    previewSvg.innerHTML = '';

    previewSvg.setAttribute('viewBox', `0 0 ${width} ${height}`);

    const bg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    bg.setAttribute('x', 0);
    bg.setAttribute('y', 0);
    bg.setAttribute('width', width);
    bg.setAttribute('height', height);
    bg.setAttribute('fill', '#fff');
    bg.setAttribute('stroke', '#111827');
    bg.setAttribute('stroke-width', '0.3');

    previewSvg.appendChild(bg);
}

function renderLayoutPreview(layout) {
    const width = parseFloat(layout.widthMm || 100);
    const height = parseFloat(layout.heightMm || 80);

    clearPreview(width, height);

    if (previewName) {
        previewName.innerText = layout.name || '';
    }

    if (layout.backgroundFilePath &&
        (
            layout.backgroundFilePath.endsWith('.png') ||
            layout.backgroundFilePath.endsWith('.jpg') ||
            layout.backgroundFilePath.endsWith('.jpeg') ||
            layout.backgroundFilePath.endsWith('.svg')
        )) {
        const img = document.createElementNS('http://www.w3.org/2000/svg', 'image');
        img.setAttribute('href', layout.backgroundFilePath);
        img.setAttribute('x', 0);
        img.setAttribute('y', 0);
        img.setAttribute('width', width);
        img.setAttribute('height', height);
        img.setAttribute('opacity', '0.35');
        previewSvg.appendChild(img);
    }

       const layoutObjects = layout.objects || layout.Objects || [];

        console.log("LAYOUT:", layout);
        console.log("OBJECTS:", layoutObjects);

        layoutObjects.forEach(obj => {
        let el;

        const type = obj.objectType || obj.ObjectType;
        const x = parseFloat(obj.x ?? obj.X ?? 0);
        const y = parseFloat(obj.y ?? obj.Y ?? 0);
        const w = parseFloat(obj.width ?? obj.Width ?? 20);
        const h = parseFloat(obj.height ?? obj.Height ?? 8);
        const fontSize = parseFloat(obj.fontSize ?? obj.FontSize ?? 4);
        const strokeWidth = parseFloat(obj.strokeWidth ?? obj.StrokeWidth ?? 0.2);

        if (type === 'Text' || type === 'VariableText') {
            el = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            el.setAttribute('x', x);
            el.setAttribute('y', y);
            el.setAttribute('font-size', fontSize);
            el.setAttribute('fill', '#111827');
            el.setAttribute('font-weight', obj.isBold ? '700' : '400');

            if (type === 'VariableText') {
                el.textContent = resolveVariable(obj.variableName || obj.VariableName);
            } else {
        el.textContent = obj.textValue || obj.TextValue || 'TEXT';            }
        }
        else if (type === 'QRCode') {
            el = document.createElementNS('http://www.w3.org/2000/svg', 'g');

            const outer = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            outer.setAttribute('x', x);
            outer.setAttribute('y', y);
            outer.setAttribute('width', w);
            outer.setAttribute('height', h);
            outer.setAttribute('fill', '#fff');
            outer.setAttribute('stroke', '#111827');
            outer.setAttribute('stroke-width', strokeWidth);

            const inner = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            inner.setAttribute('x', x + 2);
            inner.setAttribute('y', y + h / 2);
            inner.setAttribute('font-size', Math.max(2, h / 5));
            inner.setAttribute('fill', '#111827');
            inner.textContent = 'QR';

            el.appendChild(outer);
            el.appendChild(inner);
        }
        else if (type === 'DataMatrix') {
            el = document.createElementNS('http://www.w3.org/2000/svg', 'g');

            const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            rect.setAttribute('x', x);
            rect.setAttribute('y', y);
            rect.setAttribute('width', w);
            rect.setAttribute('height', h);
            rect.setAttribute('fill', '#111827');
            rect.setAttribute('opacity', '0.85');

            const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            txt.setAttribute('x', x + 1);
            txt.setAttribute('y', y + h + 3);
            txt.setAttribute('font-size', '2.5');
            txt.setAttribute('fill', '#111827');
            txt.textContent = 'DM';

            el.appendChild(rect);
            el.appendChild(txt);
        }
        else {
            el = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
            el.setAttribute('x', x);
            el.setAttribute('y', y);
            el.setAttribute('width', w);
            el.setAttribute('height', h);
            el.setAttribute('fill', 'transparent');
            el.setAttribute('stroke', '#111827');
            el.setAttribute('stroke-width', strokeWidth);
        }

        previewSvg.appendChild(el);
    });
}

function loadSelectedLayoutPreview() {
    const layoutId = $('#MarkingLayoutId').val();

    if (!layoutId) {
        clearPreview(100, 80);
        if (previewName) previewName.innerText = 'No layout selected';
        return;
    }

    fetch(`/Admin/Weapons/GetLayoutPreview?id=${layoutId}`)
        .then(response => response.json())
        .then(data => renderLayoutPreview(data));
}

$('#MarkingLayoutId').on('change', function () {
    loadSelectedLayoutPreview();
});

$('#MarkingText1, #MarkingText2, #MarkingText3, #DataMatrixValue, #QrValue').on('input', function () {
    variableValues.MarkingText1 = $('#MarkingText1').val() || '';
    variableValues.MarkingText2 = $('#MarkingText2').val() || '';
    variableValues.MarkingText3 = $('#MarkingText3').val() || '';
    variableValues.DataMatrixValue = $('#DataMatrixValue').val() || '';
    variableValues.QrValue = $('#QrValue').val() || '';

    loadSelectedLayoutPreview();
});

loadSelectedLayoutPreview();

         
            $('#weaponMarkSearchSelect').on('change', function () {
                const weaponId = $(this).val();

                if (!weaponId)
                    return;

                window.location.href = '/Admin/Weapons/Mark?weaponId=' + weaponId;
            });

            $('.ams-clickable-row').on('click', function () {
                const url = $(this).data('url');

                if (url)
                    window.location.href = url;
            });

            $('#markWeaponsTableSearch').on('keyup', function () {
                const value = $(this).val().toLowerCase();

                $('#markWeaponsTable tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });

         
        });
    </script>
}