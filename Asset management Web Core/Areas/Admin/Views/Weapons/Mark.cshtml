@model Asset_management_Web_Core.Areas.Admin.ViewModels.Weapons.WeaponMarkingViewModel
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
    ViewData["Title"] = ResourcesHelper.Translate("MarkWeapon", lang);

    var hasActiveJob = Model.LaserJobs.Any(x =>
        x.Status == "READY" ||
        x.Status == "PROCESSING");
}

<style>
    .container-custom,
    .user-profile-inner {
        width: 100% !important;
        max-width: 100% !important;
    }

    .ams-mark-grid {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) !important;
        gap: 24px !important;
        width: 100% !important;
    }

    .ams-markmaster-card {
        overflow: hidden;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 14px;
    }

    .ams-markmaster-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        border-bottom: 1px solid #334155;
    }

        .ams-markmaster-card-header > div {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .ams-markmaster-card-header strong {
            color: #f8fafc;
            font-size: 17px;
        }

        .ams-markmaster-card-header > div > span {
            color: #94a3b8;
            font-size: 13px;
        }

    .ams-markmaster-data {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        background: #334155;
    }

        .ams-markmaster-data > div {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
            padding: 18px 20px;
            background: #111827;
        }

        .ams-markmaster-data small {
            color: #94a3b8;
            font-size: 12px;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .ams-markmaster-data strong {
            color: #f8fafc;
            overflow-wrap: anywhere;
        }

    .ams-job-details {
        display: flex;
        flex-direction: column;
        gap: 3px;
        font-size: 13px;
    }

        .ams-job-details span {
            color: inherit;
        }

        .ams-job-details small {
            color: #64748b;
        }

    .ams-mark-status-ready {
        color: #94a3b8;
    }

    .ams-mark-status-processing {
        color: #f59e0b;
    }

    .ams-mark-status-marked {
        color: #22c55e;
    }

    .ams-mark-status-failed {
        color: #ef4444;
    }

    .ams-selected-option {
        font-weight: 700;
    }

    @@media (max-width: 1100px) {
        .ams-mark-grid {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 767px) {
        .ams-markmaster-data {
            grid-template-columns: 1fr;
        }

        .ams-markmaster-card-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="user-profile-inner">

    <div class="ams-page-header">
        <div>
            <h4 class="title mb-1">
                @ResourcesHelper.Translate("MarkWeapon", lang)
            </h4>

            <p class="ams-page-subtitle">
                @ResourcesHelper.Translate("MarkWeaponDescription", lang)
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success ams-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="ams-mark-grid">

        <div>
            <div class="user-profile-main-wrapper">
                <h5 class="ams-section-title">
                    @ResourcesHelper.Translate("SelectedWeapon", lang)
                </h5>

                <div class="mb-3">
                    <select id="weaponMarkSearchSelect" class="ams-select2">
                        <option value="">
                            @ResourcesHelper.Translate("SearchWeaponPlaceholder", lang)
                        </option>

                        @foreach (var item in Model.Weapons)
                        {
                            if (Model.SelectedWeaponId == item.Id)
                            {
                                <option value="@item.Id" selected>
                                    @item.RegistrationNo - @item.FactorySerial - @item.WeaponModel?.Name
                                </option>
                            }
                            else
                            {
                                <option value="@item.Id">
                                    @item.RegistrationNo - @item.FactorySerial - @item.WeaponModel?.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                @if (Model.SelectedWeapon != null)
                {
                    <div class="ams-weapon-summary">
                        <div>
                            <strong>
                                @ResourcesHelper.Translate("RegistrationNo", lang)
                            </strong>
                            <span>@Model.SelectedWeapon.RegistrationNo</span>
                        </div>

                        <div>
                            <strong>
                                @ResourcesHelper.Translate("FactorySerial", lang)
                            </strong>
                            <span>@(Model.SelectedWeapon.FactorySerial ?? "-")</span>
                        </div>

                        <div>
                            <strong>
                                @ResourcesHelper.Translate("WeaponModel", lang)
                            </strong>
                            <span>@(Model.SelectedWeapon.WeaponModel?.Name ?? "-")</span>
                        </div>

                        <div>
                            <strong>
                                @ResourcesHelper.Translate("WeaponType", lang)
                            </strong>
                            <span>@(Model.SelectedWeapon.WeaponType?.Name ?? "-")</span>
                        </div>

                        <div>
                            <strong>
                                @ResourcesHelper.Translate("Manufacturer", lang)
                            </strong>
                            <span>@(Model.SelectedWeapon.Manufacturer?.Name ?? "-")</span>
                        </div>

                        <div>
                            <strong>
                                @ResourcesHelper.Translate("Caliber", lang)
                            </strong>
                            <span>@(Model.SelectedWeapon.Caliber?.Name ?? "-")</span>
                        </div>

                        <div>
                            <strong>
                                @ResourcesHelper.Translate("RegMarked", lang)
                            </strong>

                            <span>
                                @if (Model.SelectedWeapon.IsMarked)
                                {
                                    <span class="ams-badge ams-badge-success">
                                        @ResourcesHelper.Translate("Yes", lang)
                                    </span>
                                }
                                else
                                {
                                    <span class="ams-badge ams-badge-muted">
                                        @ResourcesHelper.Translate("No", lang)
                                    </span>
                                }
                            </span>
                        </div>

                        <div>
                            <strong>Aktivni posao</strong>

                            <span>
                                @if (hasActiveJob)
                                {
                                    <span class="ams-badge ams-badge-warning">
                                        Da
                                    </span>
                                }
                                else
                                {
                                    <span class="ams-badge ams-badge-muted">
                                        Ne
                                    </span>
                                }
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info ams-alert">
                        @ResourcesHelper.Translate("SelectWeaponFromList", lang)
                    </div>
                }
            </div>

            <div class="user-profile-main-wrapper mt--30">
                <h5 class="ams-section-title">
                    @ResourcesHelper.Translate("MarkingHistory", lang)
                </h5>

                <div class="table-responsive ams-active-weapons-scroll">
                    <table class="table ams-table">
                        <thead>
                            <tr>
                                <th>@ResourcesHelper.Translate("Date", lang)</th>
                                <th>@ResourcesHelper.Translate("Layout", lang)</th>
                                <th>@ResourcesHelper.Translate("Status", lang)</th>
                                <th>Detalji</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.LaserJobs)
                            {
                                var badgeClass = item.Status switch
                                {
                                    "READY" => "ams-badge-muted",
                                    "PROCESSING" => "ams-badge-warning",
                                    "MARKED" => "ams-badge-success",
                                    "FAILED" => "ams-badge-danger",
                                    _ => "ams-badge-muted"
                                };

                                var statusClass = item.Status switch
                                {
                                    "READY" => "ams-mark-status-ready",
                                    "PROCESSING" => "ams-mark-status-processing",
                                    "MARKED" => "ams-mark-status-marked",
                                    "FAILED" => "ams-mark-status-failed",
                                    _ => string.Empty
                                };

                                <tr>
                                    <td>
                                        @item.CreatedOn.ToString("dd.MM.yyyy HH:mm:ss")
                                    </td>

                                    <td>
                                        @item.LayoutCode
                                    </td>

                                    <td>
                                        <span class="ams-badge @badgeClass">
                                            @item.Status
                                        </span>
                                    </td>

                                    <td>
                                        <div class="ams-job-details @statusClass">
                                            @if (item.Status == "READY")
                                            {
                                                <span>Čeka preuzimanje u MarkMasteru</span>
                                            }
                                            else if (item.Status == "PROCESSING")
                                            {
                                                <span>Markiranje je u toku</span>

                                                @if (item.StartedOn.HasValue)
                                                {
                                                    <small>
                                                        Započeto:
                                                        @item.StartedOn.Value.ToString("dd.MM.yyyy HH:mm:ss")
                                                    </small>
                                                }
                                            }
                                            else if (item.Status == "MARKED")
                                            {
                                                <span>Markiranje je uspješno završeno</span>

                                                @if (item.MarkedOn.HasValue)
                                                {
                                                    <small>
                                                        Završeno:
                                                        @item.MarkedOn.Value.ToString("dd.MM.yyyy HH:mm:ss")
                                                    </small>
                                                }
                                            }
                                            else if (item.Status == "FAILED")
                                            {
                                                <span>
                                                    @(item.ErrorMessage ?? "Markiranje nije uspjelo.")
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@item.Status</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }

                            @if (!Model.LaserJobs.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        @ResourcesHelper.Translate("NoRecordsFound", lang)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div>
            <div class="user-profile-main-wrapper">
                <h5 class="ams-section-title">
                    @ResourcesHelper.Translate("MarkingData", lang)
                </h5>

                @if (Model.SelectedWeapon != null)
                {
                    <form asp-action="Mark" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="SelectedWeaponId"
                               value="@Model.SelectedWeapon.Id" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        @if (Model.SelectedWeapon.IsMarked)
                        {
                            <div class="alert alert-warning ams-alert mb-3">
                                Ovo oružje je već ranije markirano. Možeš ga ponovo poslati u MarkMaster.
                            </div>
                        }

                        @if (hasActiveJob)
                        {
                            <div class="alert alert-info ams-alert mb-3">
                                Za ovo oružje već postoji aktivan posao koji čeka obradu ili se trenutno obrađuje.
                            </div>
                        }

                        <div class="ams-markmaster-card">
                            <div class="ams-markmaster-card-header">
                                <div>
                                    <strong>MarkMaster posao</strong>
                                    <span>Registracija oružja</span>
                                </div>

                                <span class="ams-badge ams-badge-muted">
                                    REGISTER_WEAPON
                                </span>
                            </div>

                            <div class="ams-markmaster-data">
                                <div>
                                    <small>MarkMaster layout</small>
                                    <strong>AMS Register weapon dot peen</strong>
                                </div>

                                <div>
                                    <small>
                                        @ResourcesHelper.Translate("RegistrationNo", lang)
                                    </small>
                                    <strong>@Model.SelectedWeapon.RegistrationNo</strong>
                                </div>

                                <div>
                                    <small>
                                        @ResourcesHelper.Translate("FactorySerial", lang)
                                    </small>
                                    <strong>
                                        @(Model.SelectedWeapon.FactorySerial ?? "-")
                                    </strong>
                                </div>

                                <div>
                                    <small>Prethodno markirano</small>

                                    @if (Model.SelectedWeapon.IsMarked)
                                    {
                                        <strong class="text-success">Da</strong>
                                    }
                                    else
                                    {
                                        <strong>Ne</strong>
                                    }
                                </div>

                                <div>
                                    <small>
                                        @ResourcesHelper.Translate("WeaponModel", lang)
                                    </small>
                                    <strong>
                                        @(Model.SelectedWeapon.WeaponModel?.Name ?? "-")
                                    </strong>
                                </div>

                                <div>
                                    <small>
                                        @ResourcesHelper.Translate("Manufacturer", lang)
                                    </small>
                                    <strong>
                                        @(Model.SelectedWeapon.Manufacturer?.Name ?? "-")
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <div class="ams-form-actions mt--20">
                            <button type="submit"
                                    class="rts-btn btn-primary"
                                    disabled="@hasActiveJob">
                                Pošalji u MarkMaster
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-info ams-alert">
                        @ResourcesHelper.Translate("SelectWeaponFromList", lang)
                    </div>
                }
            </div>

            <div class="user-profile-main-wrapper mt--30">
                <h5 class="ams-section-title">
                    @ResourcesHelper.Translate("ActiveWeapons", lang)
                </h5>

                <div class="ams-table-toolbar">
                    <input type="text"
                           id="markWeaponsTableSearch"
                           class="ams-table-search"
                           placeholder="@ResourcesHelper.Translate("Search", lang)" />
                </div>

                <div class="table-responsive ams-active-weapons-scroll">
                    <table class="table ams-table" id="markWeaponsTable">
                        <thead>
                            <tr>
                                <th>
                                    @ResourcesHelper.Translate("RegistrationNo", lang)
                                </th>
                                <th>
                                    @ResourcesHelper.Translate("FactorySerial", lang)
                                </th>
                                <th>
                                    @ResourcesHelper.Translate("WeaponModel", lang)
                                </th>
                                <th>
                                    @ResourcesHelper.Translate("RegMarked", lang)
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Weapons)
                            {
                                <tr class="ams-clickable-row"
                                    data-url="@Url.Action(
                                                                            "Mark",
                                                                            "Weapons",
                                                                            new
                                                                            {
                                                                                area = "Admin",
                                                                                weaponId = item.Id
                                                                            })">

                                <td>@item.RegistrationNo</td>
                                <td>@(item.FactorySerial ?? "-")</td>
                                <td>@(item.WeaponModel?.Name ?? "-")</td>

                                    <td>
                                    @if (item.IsMarked)
                                        {
                                            <span class="ams-badge ams-badge-success">
                                                @ResourcesHelper.Translate("Yes", lang)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ams-badge ams-badge-muted">
                                                @ResourcesHelper.Translate("No", lang)
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!Model.Weapons.Any())
                            {
                                <tr>
                                    <td colspan="4"
                                        class="text-center text-muted py-4">
                                        @ResourcesHelper.Translate("NoRecordsFound", lang)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @{
        var deviceAgentJobId = TempData["DeviceAgentJobId"];
    }

    <script>
        $(document).ready(function () {

            $('.ams-select2').select2({
                width: '100%',
                placeholder: '-- Select --',
                allowClear: true
            });

            $('#weaponMarkSearchSelect').on('change', function () {
                const weaponId = $(this).val();

                if (!weaponId) {
                    return;
                }

                window.location.href =
                    '/Admin/Weapons/Mark?weaponId=' + weaponId;
            });

            $('.ams-clickable-row').on('click', function () {
                const url = $(this).data('url');

                if (url) {
                    window.location.href = url;
                }
            });

            $('#markWeaponsTableSearch').on('keyup', function () {
                const value = $(this).val().toLowerCase();

                $('#markWeaponsTable tbody tr').filter(function () {
                    $(this).toggle(
                        $(this).text().toLowerCase().indexOf(value) > -1
                    );
                });
            });

            // =====================================================
            // DEVICE AGENT + AUTO REFRESH STATUSA
            // =====================================================

            @if (deviceAgentJobId != null)
            {
                    <text>
                    const deviceAgentJobId = @deviceAgentJobId;

                    // 1. Otvori MarkMaster Open Layout preko lokalnog agenta
                    fetch('http://localhost:5055/device/mark', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            jobId: deviceAgentJobId
                        })
                    })
                    .then(async response => {
                        const result = await response.json();

                        if (!response.ok) {
                            throw new Error(
                                result.error || 'Device Agent error.'
                            );
                        }

                        if (!result.success) {
                            throw new Error(
                                result.markMaster || 'MarkMaster error.'
                            );
                        }

                        console.log('Device Agent:', result);
                    })
                    .catch(error => {
                        console.error('Device Agent error:', error);

                        alert(
                            'Posao je kreiran, ali nije moguće otvoriti MarkMaster. ' +
                            'Provjerite da li su AMS Device Agent, MarkMaster i Layout Editor pokrenuti.\n\n' +
                            error.message
                        );
                    });

                    // 2. Provjeravaj status joba svake 2 sekunde
                    const markingStatusInterval = setInterval(function () {

                        fetch('@Url.Action("GetMarkingJobStatus", "Weapons", new { area = "Admin" })?jobId=' + deviceAgentJobId)
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error(
                                        'Status posla nije dostupan.'
                                    );
                                }

                                return response.json();
                            })
                            .then(result => {
                                console.log(
                                    'Marking status:',
                                    result.status
                                );

                                // Kad završi ili padne,
                                // osvježi stranicu
                                if (
                                    result.status === 'MARKED' ||
                                    result.status === 'FAILED'
                                ) {
                                    clearInterval(markingStatusInterval);

                                    window.location.reload();
                                }
                            })
                            .catch(error => {
                                console.error(
                                    'Marking status error:',
                                    error
                                );
                            });

                    }, 2000);
                    </text>
            }
        });
    </script>
}