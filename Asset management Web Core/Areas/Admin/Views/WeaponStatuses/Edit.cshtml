@model AMS_data.Entities.Weapons.WeaponStatus
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
    ViewData["Title"] = ResourcesHelper.Translate("EditWeaponStatus", lang);
}

<div class="user-profile-inner">

    <div class="ams-page-header">

        <div>
            <h4 class="title mb-1">
                @ResourcesHelper.Translate("EditWeaponStatus", lang)
            </h4>

            <p class="ams-page-subtitle">
                @ResourcesHelper.Translate("WeaponStatusFormDescription", lang)
            </p>
        </div>

        <a asp-action="Index"
           class="ams-btn-secondary">
            @ResourcesHelper.Translate("BackToList", lang)
        </a>

    </div>

    <div class="user-profile-main-wrapper">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <partial name="_WeaponStatusForm" model="Model" />

            <button type="submit"
                    class="rts-btn btn-primary mt--20">
                @ResourcesHelper.Translate("SaveChanges", lang)
            </button>

        </form>

    </div>

</div>