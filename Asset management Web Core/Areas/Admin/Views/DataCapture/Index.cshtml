@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
    ViewData["Title"] = ResourcesHelper.Translate("DataCapture", lang);
}

<div class="user-profile-inner">

    <div class="ams-page-header">
        <div>
            <h4 class="title mb-1">
                @ResourcesHelper.Translate("DataCapture", lang)
            </h4>

            <p class="ams-page-subtitle">
                @ResourcesHelper.Translate("DataCaptureDescription", lang)
            </p>
        </div>
    </div>

    <div class="ams-card-grid">

        <!-- WEAPON DATA -->

        <div class="ams-module-card">

            <div class="ams-module-icon">
                <i class="fa-solid fa-gun"></i>
            </div>

            <h5>
                @ResourcesHelper.Translate("WeaponData", lang)
            </h5>

            <p>
                @ResourcesHelper.Translate("WeaponDataDescription", lang)
            </p>

            <div class="ams-module-links">
                <a asp-area="Admin" asp-controller="Lookups" asp-action="Items" asp-route-categoryKey="WeaponState">
                    @ResourcesHelper.Translate("WeaponState", lang)
                </a>

                <a asp-area="Admin" asp-controller="Lookups" asp-action="Items" asp-route-categoryKey="WeaponLegality">
                    @ResourcesHelper.Translate("WeaponLegality", lang)
                </a>

                <a asp-area="Admin" asp-controller="Lookups" asp-action="Items" asp-route-categoryKey="WeaponItemType">
                    @ResourcesHelper.Translate("WeaponItemType", lang)
                </a>

                <a asp-area="Admin" asp-controller="Lookups" asp-action="Items" asp-route-categoryKey="ManufactureYear">
                    @ResourcesHelper.Translate("ManufactureYear", lang)
                </a>

                <a asp-area="Admin" asp-controller="Lookups" asp-action="Items" asp-route-categoryKey="PurposeOfUse">
                    @ResourcesHelper.Translate("PurposeOfUse", lang)
                </a>

                <a asp-area="Admin" asp-controller="Lookups" asp-action="Items" asp-route-categoryKey="CheckState">
                    @ResourcesHelper.Translate("CheckState", lang)
                </a>
                <a asp-area="Admin"
                   asp-controller="WeaponTypes"
                   asp-action="Index">
                    @ResourcesHelper.Translate("WeaponTypes", lang)
                </a>

                <a asp-area="Admin" asp-controller="Manufacturers" asp-action="Index">
                    @ResourcesHelper.Translate("Manufacturers", lang)
                </a>

                <a asp-area="Admin" asp-controller="Calibers" asp-action="Index">
