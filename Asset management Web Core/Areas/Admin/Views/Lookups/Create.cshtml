@model AMS_data.Entities.Lookups.LookupItem
@using AMS_data.Entities.Lookups
@using Asset_management_Web_Core.Helpers

@{
    var lang = Context.Items["lang"]?.ToString() ?? "bs";
    var category = ViewBag.Category as LookupCategory;

    ViewData["Title"] = ResourcesHelper.Translate("AddLookupItem", lang);
}

<div class="user-profile-inner">
    <div class="ams-page-header">
        <div>
            <h4 class="title mb-1">@ResourcesHelper.Translate("AddLookupItem", lang)</h4>
            <p class="ams-page-subtitle">
                @category?.Name
            </p>
        </div>

        <a asp-action="Items"
           asp-route-categoryKey="@category?.Key"
           class="ams-btn-secondary">
            @ResourcesHelper.Translate("BackToList", lang)
        </a>
    </div>

    <div class="user-profile-main-wrapper">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="LookupCategoryId" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <partial name="_LookupItemForm" model="Model" />

            <button type="submit" class="rts-btn btn-primary mt--20">
                @ResourcesHelper.Translate("Save", lang)
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}