@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="single-form-s-wrapper">
    <div class="head">
        <span>Dobrodošli nazad</span>
        <h5 class="title">Prijava u AMS</h5>
    </div>

    <div class="body">
        <form id="account" method="post">
            <input asp-for="Input.DeviceLicensed" type="hidden" id="DeviceLicensed" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="input-wrapper">
                <input asp-for="Input.UserName" placeholder="Korisničko ime" autocomplete="username" />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>

                <input asp-for="Input.Password" placeholder="Lozinka" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="check-wrapper">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        Zapamti me
                    </label>
                </div>
            </div>

            <button type="submit" class="rts-btn btn-primary">Prijavi se</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

    <script>
        document.addEventListener("DOMContentLoaded", async function () {

            const form = document.querySelector("form");
            const hidden = document.getElementById("DeviceLicensed");

            try {

                const response = await fetch("http://localhost:5055/device/license");

                if (!response.ok) {
                    alert("AMS Device Agent nije dostupan.");
                    return;
                }

                const data = await response.json();

                if (data.licensed === true) {
                    hidden.value = "true";
                }
                else {
                    alert("Licenca nije aktivna. Status: " + data.status);
                }

            } catch (e) {

                alert("Device Agent nije pokrenut.");

            }

            form.addEventListener("submit", function (e) {

                if (hidden.value !== "true") {

                    e.preventDefault();

                    alert("Login nije dozvoljen bez aktivne licence.");

                }

            });

        });
    </script>
