@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="single-form-s-wrapper">
    <div class="head">
        <span>Dobrodošli nazad</span>
        <h5 class="title">Prijava u AMS</h5>
    </div>

    <div class="body">
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="input-wrapper">
                <input asp-for="Input.UserName" placeholder="Korisničko ime" autocomplete="username" />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>

                <input asp-for="Input.Password" placeholder="Lozinka" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="check-wrapper">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        Zapamti me
                    </label>
                </div>
            </div>

            <button type="submit" class="rts-btn btn-primary">Prijavi se</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}